@model EventFormViewModel

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@(Model.IsEdit ? Model.EventId : (int?)null)" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="BannerUrl" />

    <div class="row g-3">
        <div class="col-12">
            <label asp-for="EventName" class="form-label"></label>
            <input asp-for="EventName" class="form-control" />
            <span asp-validation-for="EventName" class="field-error"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="field-error"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="EventDate" class="form-label"></label>
            <input asp-for="EventDate" type="date" class="form-control" />
            <span asp-validation-for="EventDate" class="field-error"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" placeholder="Johannesburg, Gauteng" />
            <span asp-validation-for="Location" class="field-error"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Distance" class="form-label"></label>
            <input asp-for="Distance" type="number" step="0.1" min="0.1" class="form-control" />
            <span asp-validation-for="Distance" class="field-error"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
            <span asp-validation-for="EventType" class="field-error"></span>
        </div>

        <div class="col-12">
            <label asp-for="Banner" class="form-label"></label>
            @if (!string.IsNullOrEmpty(Model.BannerUrl))
            {
                <div class="banner-preview">
                    <img src="@Model.BannerUrl" alt="Current banner" />
                    <small>Current banner. Choose a new image below to replace it.</small>
                </div>
            }
            <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" data-image-preview="#banner-new-preview" />
            <div class="form-text">JPG, PNG, GIF or WEBP, up to 5 MB. Wide images (about 1200 x 600) look best.</div>
            <span asp-validation-for="Banner" class="field-error"></span>
            <img id="banner-new-preview" class="banner-new-preview d-none" alt="Preview of the new banner" />
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Save changes" : "Create event")</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>
