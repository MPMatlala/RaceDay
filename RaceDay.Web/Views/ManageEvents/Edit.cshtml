@model EventFormViewModel
@{
    ViewData["Title"] = "Edit event";
}

<div class="page-head">
    <div>
        <h1>Edit event</h1>
        <p class="page-sub">@Model.EventName</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-controller="ManageCategories" asp-action="Index" asp-route-eventId="@Model.EventId">Categories</a>
        <a class="btn btn-outline-primary" asp-controller="ManageResults" asp-action="Index" asp-route-eventId="@Model.EventId">Results</a>
    </div>
</div>

<div class="rd-card form-card">
    <partial name="_EventForm" model="Model" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
