@model EventBrowseViewModel
@{
    ViewData["Title"] = "Upcoming events";
}

<div class="page-head">
    <div>
        <h1>Upcoming events</h1>
        <p class="page-sub">Find your next start line, then pick a category and enrol.</p>
    </div>
</div>

<form method="get" asp-action="Index" class="filter-bar rd-card" role="search">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label for="keyword" class="form-label">Search</label>
            <input id="keyword" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Name or description" />
        </div>
        <div class="col-md-3">
            <label for="location" class="form-label">Location</label>
            <input id="location" name="location" value="@Model.Location" class="form-control" placeholder="City or province" />
        </div>
        <div class="col-md-2">
            <label for="date" class="form-label">Date</label>
            <input id="date" name="date" type="date" value="@(Model.Date.HasValue ? Model.Date.Value.ToString("yyyy-MM-dd") : "")" class="form-control" />
        </div>
        <div class="col-md-2">
            <label for="eventType" class="form-label">Type</label>
            <select id="eventType" name="eventType" class="form-select">
                <option value="">All types</option>
                <option value="Run" selected="@(Model.EventType == "Run")">Run</option>
                <option value="Walk" selected="@(Model.EventType == "Walk")">Walk</option>
                <option value="Cycle" selected="@(Model.EventType == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            @if (Model.HasFilters)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" aria-label="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="empty-state">
        <i class="bi bi-search"></i>
        <h2>@(Model.HasFilters ? "No events match those filters" : "No upcoming events yet")</h2>
        <p>@(Model.HasFilters ? "Try a different search, or clear the filters to see everything." : "Check back soon. New events are added all the time.")</p>
        @if (Model.HasFilters)
        {
            <a class="btn btn-primary" asp-action="Index">Clear filters</a>
        }
    </div>
}
else
{
    <p class="meta result-count">@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events")</p>
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            bool enrolled = Model.EnrolledEventIds.Contains(ev.EventId);
            <div class="col-md-6 col-xl-4">
                <article class="rd-card event-card h-100">
                    <a class="banner" asp-action="Details" asp-route-id="@ev.EventId" tabindex="-1" aria-hidden="true">
                        <partial name="_Banner" model="ev" />
                        <span class="type-pill"><i class="bi @Fmt.TypeIcon(ev.EventType)"></i> @ev.EventType</span>
                    </a>
                    <div class="event-card-body">
                        <div class="d-flex gap-3">
                            <partial name="_DateBib" model="ev.EventDate" />
                            <div>
                                <h2 class="event-title"><a asp-action="Details" asp-route-id="@ev.EventId">@ev.EventName</a></h2>
                                <p class="meta mb-1"><i class="bi bi-geo-alt-fill"></i> @ev.Location</p>
                                <p class="meta mb-0"><i class="bi bi-signpost-2-fill"></i> @Fmt.Distance(ev.Distance)</p>
                            </div>
                        </div>
                    </div>
                    <div class="event-card-actions">
                        @if (enrolled)
                        {
                            <span class="status-badge status-confirmed"><i class="bi bi-check-lg"></i> You are enrolled</span>
                        }
                        <a class="btn btn-sm @(enrolled ? "btn-outline-primary" : "btn-primary") ms-auto" asp-action="Details" asp-route-id="@ev.EventId">@(enrolled ? "View event" : "View & enrol")</a>
                    </div>
                </article>
            </div>
        }
    </div>
}
