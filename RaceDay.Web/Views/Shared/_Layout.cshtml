@{
    var session = Context.Session;
    bool loggedIn = session.IsLoggedIn();
    string role = session.GetRole();
    string fullName = session.GetFullName();
    string picture = session.GetPicture();
    string current = (ViewContext.RouteData.Values["controller"] ?? "").ToString();

    string Active(params string[] controllers)
    {
        return controllers.Contains(current, StringComparer.OrdinalIgnoreCase) ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] == null ? "RaceDay" : ViewData["Title"] + " | RaceDay")</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231B3BFF'/%3E%3Cpath d='M9 24L17 8h6l-8 16z' fill='%23FFD60A'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main">Skip to content</a>

    <header>
        <nav class="navbar navbar-expand-lg rd-nav" aria-label="Main navigation">
            <div class="container">
                <a class="rd-brand" asp-controller="Home" asp-action="Index" aria-label="RaceDay home">
                    <span class="rd-brand-mark"><i class="bi bi-lightning-charge-fill"></i></span>RACE<span>DAY</span>
                </a>
                <button class="navbar-toggler rd-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (!loggedIn)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a></li>
                        }
                        else if (role == "Organiser")
                        {
                            <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("ManageEvents")" asp-controller="ManageEvents" asp-action="Index"><i class="bi bi-flag-fill"></i> Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("ManageCategories")" asp-controller="ManageCategories" asp-action="Index"><i class="bi bi-tags-fill"></i> Categories</a></li>
                            <li class="nav-item"><a class="nav-link @Active("ManageEnrolments")" asp-controller="ManageEnrolments" asp-action="Index"><i class="bi bi-people-fill"></i> Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("ManageResults")" asp-controller="ManageResults" asp-action="Index"><i class="bi bi-stopwatch-fill"></i> Results</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Events")" asp-controller="Events" asp-action="Index"><i class="bi bi-calendar-event-fill"></i> Events</a></li>
                            <li class="nav-item"><a class="nav-link @Active("MyEnrolments")" asp-controller="MyEnrolments" asp-action="Index"><i class="bi bi-ticket-perforated-fill"></i> My enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("MyResults")" asp-controller="MyResults" asp-action="Index"><i class="bi bi-trophy-fill"></i> My results</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-fill"></i> Profile</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2 nav-user">
                        @if (loggedIn)
                        {
                            if (!string.IsNullOrEmpty(picture))
                            {
                                <img src="@picture" alt="" class="avatar-sm" />
                            }
                            else
                            {
                                <span class="avatar-sm avatar-initial" aria-hidden="true">@(string.IsNullOrEmpty(fullName) ? "?" : fullName.Substring(0, 1).ToUpper())</span>
                            }
                            <span class="nav-user-name">@fullName <small>@role</small></span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-light rd-logout">Log out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-sm btn-accent" asp-controller="Account" asp-action="Register">Sign up</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
        <div class="rd-stripe" aria-hidden="true"></div>
    </header>

    <main id="main" class="container rd-main">
        <partial name="_Flash" />
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span class="rd-footer-brand">RACE<span>DAY</span></span>
            <span>Run it. Walk it. Ride it.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
