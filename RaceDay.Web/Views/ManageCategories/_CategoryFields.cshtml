@model CategoryFormViewModel

<div class="mb-3">
    <label asp-for="CategoryName" class="form-label"></label>
    <input asp-for="CategoryName" class="form-control" placeholder="10km, 21km, Under 20, Senior ..." />
    <span asp-validation-for="CategoryName" class="field-error"></span>
</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
        <span asp-validation-for="DistanceKm" class="field-error"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="EntryFee" class="form-label"></label>
        <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="EntryFee" class="field-error"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="MaxParticipants" class="form-label"></label>
        <input asp-for="MaxParticipants" type="number" step="1" min="1" class="form-control" />
        <span asp-validation-for="MaxParticipants" class="field-error"></span>
    </div>
</div>
